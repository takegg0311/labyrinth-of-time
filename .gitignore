node_modules/
dist/
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# 環境変数（API キー）
.env

# 問題データの実体はリポジトリに含めない。
# ただしサンプルとして questions_example.csv と、対応する 1 ゲーム分
# （20001204 の 12 問）の音声を追跡する。clone しただけで実際に遊べる
# 状態にしておくと、動作確認に自分で音声を用意せずに済む。
quiz_data/*
!quiz_data/questions_example.csv
!quiz_data/20001204/
quiz_data/20001204/*
!quiz_data/20001204/*.wav
!quiz_data/20001204/*.txt
# VOICEPEAK のプロジェクトファイルと全体出力は使わないので追跡しない
quiz_data/20001204/20001204.txt
quiz_data/20001204/*.vpp
*.tsbuildinfo
